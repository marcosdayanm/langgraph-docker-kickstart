# Run `gcloud auth application-default login`, then set the generated ADC file's absolute path.
GCP_ADC_PATH=/absolute/path/to/application_default_credentials.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
MODEL_ID=gemini-2.5-flash
VERTEX_MODEL=gemini-2.5-flash
LOCAL_USER_ID=local-user
# Optional: enable live LangChain/LangGraph traces in your LangSmith project.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=your-langsmith-project

# Used by `uv run ...` outside Docker. Compose overrides this host with `postgres`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph?sslmode=disable
